APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = your_database_name
USERNAME = your_database_user
PASSWORD = your_database_password
HOSTPORT = 3306
PREFIX = as_
CHARSET = utf8mb4

[CACHE]
DRIVER = redis

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 1
TIMEOUT = 0
NAME = entry:
TOKEN_SELECT = 1
CACHE_SELECT = 2
QUEUE_SELECT = 3

[QUEUE]
DEFAULT = redis
